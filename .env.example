# =============================================================================
# Indie Archive — environment configuration
# Copy to .env and fill in. NEVER commit .env. NEVER commit real tokens.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indie_archive

# --- Producer (print/fulfilment supplier) ------------------------------------
# Which adapter the CLI uses by default. printful | gelato
DEFAULT_PRODUCER=printful

# Printful. Token from the Printful dashboard (private token / OAuth app token).
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=

# Gelato. API key from the Gelato dashboard.
GELATO_API_KEY=

# When true, adapters read recorded fixtures instead of calling the network.
# Economics computed from fixtures are marked source=FIXTURE and CANNOT be
# published — publication requires source=LIVE_API.
PRODUCER_USE_FIXTURES=true

# A cost quote older than this is stale and blocks pricing/publication.
COST_QUOTE_TTL_MINUTES=1440

# --- Shopify -----------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# --- Anthropic (product copy, SEO, creative concepts) ------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Commercial configuration ------------------------------------------------
# These are YOUR numbers. There are no defaults for the VAT lines on purpose:
# guessing them misstates contribution per unit by double digits.
BASE_CURRENCY=GBP

# Are you VAT registered? If false, VAT_RATE_PCT is ignored and no VAT is
# deducted from revenue.
VAT_REGISTERED=
VAT_RATE_PCT=20

# Payment processing. Percentage of gross (VAT-inclusive) revenue plus a fixed
# fee per transaction, in minor units (pence).
PAYMENT_FEE_PCT=
PAYMENT_FEE_FIXED_MINOR=

# Additional platform/marketplace fee as a percentage of gross revenue.
# Shopify charges this when not using Shopify Payments. 0 if not applicable.
PLATFORM_FEE_PCT=0

# Expected proportion of sold units returned. Modelled conservatively as a
# total loss of that unit (no resale recovery). See docs/architecture.md.
RETURNS_ALLOWANCE_PCT=

# Target contribution BEFORE advertising, as a percentage of net revenue.
# This is what the price solver aims for: it sets the retail price.
TARGET_CONTRIBUTION_BEFORE_ADS_PCT=

# Target contribution AFTER advertising, as a percentage of net revenue.
# This is the profit you want to keep once ads are paid for; it sets target
# CPA and target ROAS. Must be lower than the before-ads target, or there is
# no budget left to acquire a customer.
TARGET_CONTRIBUTION_AFTER_ADS_PCT=

# Retail price rounding. Proposed prices are rounded UP to the nearest step,
# then to the configured ending. 100 = £1.00 steps, ending 0 = £X.00 prices.
PRICE_ROUNDING_STEP_MINOR=100
PRICE_ROUNDING_ENDING_MINOR=0

# --- Meta (milestone 3 — NO adapter exists yet) ------------------------------
# Meta write operations are disabled by default and there is currently no Meta
# adapter in this codebase, so no code path can spend money.
META_WRITE_ENABLED=false

# Established once by `ia meta:setup` and then pinned. The app-scoped user ID
# is the authorisation key — NOT the email address, which Meta does not
# reliably expose and which is not a stable identifier.
# Human label for the expected identity, used only on the setup screen:
META_EXPECTED_IDENTITY_LABEL=Robinson.matthew@gmail.com
META_APPROVED_USER_ID=
META_APPROVED_BUSINESS_ID=
META_APPROVED_AD_ACCOUNT_ID=
META_APPROVED_PAGE_ID=
META_APPROVED_INSTAGRAM_ACCOUNT_ID=
META_APPROVED_PIXEL_ID=
META_APPROVED_DATASET_ID=

# Business Manager IDs that must NEVER be touched (Apriil / N60 GROUP assets).
# Comma-separated Meta business IDs, populated during `ia meta:setup`.
# Enforcement is by ID, not name — a renamed asset still trips this.
META_DENIED_BUSINESS_IDS=

# Meta app credentials live in secret storage, never in the database.
META_APP_ID=
META_APP_SECRET=
